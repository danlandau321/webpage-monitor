# Copy to ".env" for local testing:  set -a; . ./.env; set +a; python monitor.py
# In GitHub, set the SMTP_* / EMAIL_* values as Secrets and the MONITOR_* values
# as Variables (Settings -> Secrets and variables -> Actions). Never commit real .env.

# ---- What to watch ----
MONITOR_URL=https://example.com/some/page-or-api
MONITOR_MODE=raw            # raw | json | selector
MONITOR_FIELD=              # json mode: dot path, e.g. footerMessage
MONITOR_SELECTOR=           # selector mode: a CSS selector, e.g. #notice
MONITOR_HEADERS=            # optional JSON, e.g. {"X-Example-Id":"123"}
MONITOR_LABEL=My page       # friendly name shown in the email subject
ALWAYS_EMAIL=false          # true = email every run even when nothing changed

# ---- How to email (example uses Gmail SMTP with an App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password  # Gmail: create at myaccount.google.com/apppasswords
EMAIL_FROM=you@example.com
EMAIL_TO=where-to-send@example.com
